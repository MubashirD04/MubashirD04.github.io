---
import fs from "node:fs";
import Layouts from "../layouts/layouts.astro";
import Contact from "../components/Contact.astro";

// Placeholder entries: replace the years and text with your own. Order is oldest first.
const timeline = [
  {
    year: "20XX",
    title: "Started Computer Science at UCT",
    text: "Began a BSc in Computer Science at the University of Cape Town.",
  },
  {
    year: "2025",
    title: "Capstone: AI Content Detector",
    text: "Final-year team project: a transformer-based detector behind a Flask API with a React frontend.",
  },
  {
    year: "20XX",
    title: "Graduated",
    text: "Completed the BSc in Computer Science.",
  },
  {
    year: "20XX",
    title: "Client work: JASS annual report",
    text: "Built an interactive microsite for Just Associates' 2025 annual report.",
  },
  {
    year: "Now",
    title: "Building Simple Books",
    text: "An AI-native accounting app for South African accountants, from bank statement to VAT201.",
  },
];

// Drop the PDF at this path and the Download CV button appears.
const CV_PATH = "/downloads/Mubashir-Dawood-CV.pdf";
const hasCv = fs.existsSync(`public${CV_PATH}`);
---

<Layouts
  title="About | Mubashir Dawood"
  description="Computer Science graduate and software engineer based in Cape Town, South Africa, specializing in Go, Python, and data-driven backend systems."
>
  <h1 class="section-title about-title">About Me</h1>

  <div class="arcade-stage" id="arcadeStage">
    <div class="game-card-wrapper" id="gameCardWrapper">
      <div class="game-card-inner" id="gameCardInner">
      <div class="card-face card-face-front profile-card game-card">
        <div class="card-header">
          <small>Class: Software Engineer</small>
          <h2>Mubashir</h2>
        </div>

        <div class="profile-grid">
          <div class="avatar">
            <span>🕹️</span>
            <b>LVL 4</b>
          </div>

          <div class="perks">
            <div>
              <span class="perk-bullet" style="--clr: #4ade80">⚡</span> +50% Async Performance
            </div>
            <div>
              <span class="perk-bullet" style="--clr: #fbbf24">🥊</span> Muay Thai Stance
            </div>
            <div>
              <span class="perk-bullet" style="--clr: #f87171">🚗</span> Track Tuned Iteration
            </div>
          </div>
        </div>

        <!-- Attributes -->
        <div class="attributes">
          <h3>Attributes</h3>

          <div class="stat">
            <label>Backend / Systems <span>80/100</span></label>
            <div class="bar">
              <div class="fill" style="--clr: var(--primary-color); --val: 80%">
              </div>
            </div>
          </div>

          <div class="stat">
            <label>Frontend / UI <span>60/100</span></label>
            <div class="bar">
              <div class="fill" style="--clr: #10b981; --val: 60%"></div>
            </div>
          </div>

          <div class="stat">
            <label>Data & Analytics <span>70/100</span></label>
            <div class="bar">
              <div class="fill" style="--clr: #a855f7; --val: 70%"></div>
            </div>
          </div>
        </div>

        <!-- Inventory -->
        <div class="inventory">
          <h3>Equipped Inventory</h3>
          <div class="tags">
            <span class="skill-tag">Python</span>
            <span class="skill-tag">SvelteKit</span>
            <span
              class="skill-tag skill-tag-game"
              id="astroTrigger"
              role="button"
              tabindex="0"
              aria-label="Launch the Astro Blaster arcade game"
              title="Launch Astro Blaster"
              >Astro</span
            >
            <span class="skill-tag">SQLite</span>
            <span class="skill-tag">Go</span>
            <span class="skill-tag">HuggingFace</span>
            <span class="skill-tag">Groq</span>
          </div>
        </div>
      </div>

      <div class="card-face card-face-back game-card">
        <div class="card-header">
          <small>Arcade Mode</small>
          <h2>Leaderboard</h2>
        </div>

        <ol class="leaderboard" id="leaderboardList">
          <li class="leaderboard-empty">No scores yet — go fly!</li>
        </ol>

        <button class="game-exit-btn" id="gameExitBtn" type="button">
          ✕ Exit Game
        </button>
      </div>
      </div>
    </div>

    <div class="game-arena" id="gameArena" aria-hidden="true">
      <div class="game-hud">
        <span id="gameScore">SCORE 0000</span>
        <span id="gameLives">♥ ♥ ♥</span>
      </div>
      <div class="game-screen">
        <canvas id="gameCanvas" width="384" height="240"></canvas>

        <!-- off-screen, but a real input: focusing it is what raises the
             on-screen keyboard for the high score initials on touch -->
        <input
          class="game-initials-input"
          id="gameInitials"
          type="text"
          maxlength="3"
          inputmode="text"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="characters"
          spellcheck="false"
          tabindex="-1"
          aria-label="Enter your initials"
        />

        <div class="rickroll" id="rickroll" hidden>
          <p class="rickroll-title">⚠ 1000 POINTS &middot; YOU'VE BEEN RICKROLLED</p>
          <div class="rickroll-frame" id="rickrollFrame"></div>
          <button type="button" class="rickroll-close" id="rickrollClose">
            Resume Game
          </button>
        </div>
      </div>

      <p class="game-hint">
        <span class="game-hint-keys"
          >WASD / ARROWS to move &middot; SPACE to fire &middot; ESC to exit</span
        >
        <span class="game-hint-touch"
          >TAP anywhere to aim &amp; fire &middot; DRAG to sweep</span
        >
      </p>
    </div>
  </div>

  <section id="about">
    <div class="about-card">
      <p>
        I'm a Computer Science graduate who finds beauty in the "under the hood"
        mechanics of software. Whether I'm architecting a Go backend, optimizing
        a data pipeline, or fine-tuning an API, I'm driven by a need for
        performance and correctness.
      </p>
      <p>
        My approach to engineering is influenced by my life outside of the IDE.
        As a martial arts and fitness enthusiast, I believe in the power of
        incremental improvement and technical discipline, principles that
        translate directly to writing clean, maintainable code. When I'm not
        debugging systems or training, you'll likely find me absorbed in a
        strategy game or lost in a book.
      </p>
    </div>
  </section>

  <section id="journey">
    <h2 class="section-title">Journey</h2>
    <ol class="timeline" data-timeline>
      {
        timeline.map((item, i) => (
          <li class="timeline-item" style={`--i: ${i}`}>
            <span class="timeline-dot" aria-hidden="true" />
            <p class="timeline-year">{item.year}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="hire">
    <div class="card hire-card">
      <p class="hire-eyebrow">Open to work</p>
      <h2>Hire me</h2>
      <p>
        I'm looking for a graduate or junior role on an engineering-focused team,
        working on backend services, systems programming or data-driven
        applications.
      </p>
      <div class="hire-actions">
        {
          hasCv ? (
            <a href={CV_PATH} class="hero-btn hero-btn-primary" download>
              Download CV
            </a>
          ) : (
            <a
              href="mailto:mubashir.dawood4@gmail.com?subject=CV%20request"
              class="hero-btn hero-btn-primary"
            >
              Email me for my CV
            </a>
          )
        }
        <a href="#contact" class="hero-btn hero-btn-secondary">Get in touch</a>
      </div>
    </div>
  </section>

  <Contact />
</Layouts>
