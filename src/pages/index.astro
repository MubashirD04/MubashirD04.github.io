---
import Layouts from "../layouts/layouts.astro";
import Contact from "../components/Contact.astro";
import { Image } from "astro:assets";
import tiger_pc from "../assets/Tiger/Tiger_pc_bgr.png";
---

<Layouts
  title="Mubashir Dawood | Full Stack Developer & Software Engineer"
  description="Personal portfolio of Mubashir Dawood, a Full Stack Developer specializing in JavaScript, Go, and AI integration. Explore my projects and skills."
>
  <div id="hero">
    <section id="header">
      <h1 class="hero-title">Hi, my name is Mubashir</h1>
      <h2 class="hero-subtitle">
        I'm a junior developer from Cape Town,<br /> South Africa
      </h2>
    </section>
    <div class="hero-tiger-wrapper">
      <Image
        src={tiger_pc}
        alt="Tiger"
        class="hero-tiger-img"
        loading="eager"
      />
    </div>
    <div class="scroll-indicator">
      <div class="mouse"></div>
      <span class="scroll-text">Scroll</span>
    </div>
  </div>

  <section id="about-cta">
    <h2 class="about-heading">Lets work together</h2>
    <div class="about-text">
      <p>
        <span class="mobile-inline"
          >I'm a junior developer from Cape Town, South Africa.</span
        >
        From optimizing complex data pipelines to scaling background workers, high-throughput
        APIs to crafting seamless progressive web apps. I help awesome people turn
        ambitious ideas into fast, reliable, and accessible digital infrastructure.
      </p>
    </div>
    <a href="/about" class="about-cta-button">About me</a>
  </section>

  <section id="current-focus">
    <h2 class="section-title">Current Focus</h2>
    <div class="current-focus-subtitle">
      <p>Projects I'm currently working on</p>
    </div>
    <div class="current-projects">
      <div class="current-project-card" id="project-1">
        <!-- <div class="current-project-card-image">
                    <Image src="" alt="Project Logo" loading="lazy"/>
                </div> -->
        <h3>Workout Dashboard</h3>
        <p>
          As a fitness enthusiast and someone who likes looking at data, I
          thought it would be cool to have a dashboard displaying all types of
          metrics. With that idea in mind, I decided on a web app using react
          for the front end and the Recharts library to display those metrics. I
          also added a chatbot via groq that analyses a users data via vector
          searching in the convex database.
        </p>
        <a
          href="https://github.com/MubashirD04/Workout_Dashboard"
          target="_blank"
          class="project-link">GitHub</a
        >
      </div>
    </div>
  </section>

  <Contact />
</Layouts>
