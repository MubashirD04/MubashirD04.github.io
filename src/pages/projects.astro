---
import Layouts from "../layouts/layouts.astro";

const featured = {
    name: "Simple Books",
    summary: "An AI-native accounting web app for South African accountants, from bank statement to VAT201.",
    overview: [
        "Lets an accountant run real client books: upload a bank statement and each transaction is categorised by the client's own rules, then built-in SA rules, then an AI fallback.",
        "Confirming a transaction posts a balanced double-entry journal through a shared VAT engine, which feeds the chart of accounts, general ledger, trial balance, invoicing and VAT201 returns.",
    ],
    highlights: [
        "Parses PDF and CSV statements from FNB, Absa, Capitec, Nedbank, Standard Bank and Investec",
        "Amounts never touch floating point",
        "Anything sent to the AI is masked and schema-validated first",
    ],
    tech: ["SvelteKit", "TypeScript", "Postgres", "Drizzle ORM", "pdf.js", "LLM API", "Clerk", "Docker", "Render"],
    link: { href: "https://simple-books-jyn9.onrender.com/login", label: "Visit site" },
};

const projects = [
    {
        name: "Workout Dashboard",
        summary: "Fitness tracking with rich data visualisations and an AI coach that reads your own training data.",
        overview: [
            "Tracks workouts, cardio, body metrics, nutrition and progress photos, and turns them into charts: volume over time, a consistency heatmap, an athlete radar and a macro breakdown.",
            "An AI fitness coach uses RAG, vector searching your logged data and expert knowledge, to give personalised advice. Admin, trainer and client roles let trainers invite and follow their clients, while progress photos stay private to the client.",
        ],
        tech: ["React", "Vite", "Tailwind CSS", "Recharts", "Convex", "LLM API", "Clerk"],
        link: { href: "https://github.com/MubashirD04/Workout_Dashboard", label: "GitHub" },
    },
    {
        name: "JASS 2025 Annual Report",
        summary: "An interactive microsite for Just Associates' 2025 annual report.",
        overview: [
            "A microsite built for JASS (Just Associates), presenting their 2025 annual report as an interactive web experience.",
        ],
        tech: ["HTML", "CSS", "Vanilla JavaScript"],
        link: { href: "https://justassociates.org/mc/ar/2025/", label: "Visit site" },
    },
    {
        name: "Tab Bridge",
        summary: "A Firefox extension and local MCP daemon that lets Claude read the tabs you explicitly allow.",
        overview: [
            "Lets Claude Code (or Claude Desktop) read the HTML, console logs, network requests, and screenshots of specific Firefox tabs you explicitly allow, plus any tab on a trusted local dev server, without a manual click every time.",
            "A local daemon binds to 127.0.0.1 only, everything is read-only, and console/network capture is off by default until opted in per-tab.",
        ],
        tech: ["TypeScript", "WebSocket", "MCP", "Firefox WebExtensions API"],
        link: { href: "https://github.com/MubashirD04/Tab-bridge", label: "GitHub" },
    },
    {
        name: "AI Content Detector",
        summary: "A web app that detects whether text was written by AI or a human.",
        overview: [
            "Helps users determine whether a given text is likely to have been generated by an AI or written by a human.",
            "A Flask backend API serves a self-trained detector model, with a React frontend for user interaction.",
        ],
        tech: ["Flask", "React", "Node.js", "REST APIs", "Pandas", "NumPy"],
        link: { href: "https://github.com/meekaaeelBooley/AI-Content-Detector", label: "GitHub" },
    },
    {
        name: "Notes CLI",
        summary: "A fast Go CLI that turns lecture transcripts into structured AI notes, grouped by course.",
        overview: [
            "Addresses the problem of taking notes from lectures, and transforms lecture transcripts into structured, detailed AI notes.",
            "Notes are grouped by course, synced to Joplin, and searchable via a built-in AI assistant.",
        ],
        tech: ["Go", "LLM API", "Joplin", "JSON"],
        link: { href: "https://github.com/MubashirD04/Note-Creator-CLI-Tool", label: "GitHub" },
    },
    {
        name: "Social Network RAG",
        summary: "Turns raw group chat exports into an interactive social graph, exposed via an API, MCP server, and web UI.",
        overview: [
            "Turns raw group chat exports (WhatsApp, Telegram, Slack) into an interactive directed graph using local machine learning, with no external LLM API costs for the core analysis.",
            "It identifies key influencers (PageRank), information brokers (betweenness centrality), and community clusters, and supports semantic search (RAG) over the full conversation history. A conversation-linking layer infers likely connections between unthreaded messages, kept visually distinct from confirmed replies so a guess never inflates anyone's influence score.",
        ],
        tech: ["FastAPI", "NetworkX", "YAKE", "fastembed", "ONNX Runtime", "MCP", "React", "Vite"],
        link: { href: "https://github.com/MubashirD04/Social-Network-RAG", label: "GitHub" },
    },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<Layouts title="Projects | Mubashir Dawood" description="Selected projects by Mubashir Dawood, including an AI-native accounting app, a fitness dashboard, a Go-based notes CLI, and a social network analysis tool.">
    <section id="projects">
        <h1 class="section-title">Selected Projects</h1>

        <div class="projects-layout">
            <article class="card project-feature">
                <div class="project-feature-main">
                    <span class="project-badge">Currently building</span>
                    <h2>{featured.name}</h2>
                    <p class="project-feature-summary">{featured.summary}</p>
                    {featured.overview.map((para) => <p>{para}</p>)}
                    <div class="project-cta-row">
                        <a class="project-cta" href={featured.link.href} target="_blank" rel="noopener">
                            {featured.link.label} <span aria-hidden="true">↗</span>
                        </a>
                        <span class="project-cta-note">Demo</span>
                    </div>
                </div>
                <aside class="project-feature-side">
                    <h3>Highlights</h3>
                    <ul class="project-highlights">
                        {featured.highlights.map((item) => <li>{item}</li>)}
                    </ul>
                    <h3>Tech Stack</h3>
                    <ul class="project-tags">
                        {featured.tech.map((t) => <li>{t}</li>)}
                    </ul>
                </aside>
            </article>

            <div class="project-list">
                <div class="project-list-head">
                    <span>More work</span>
                    <span>{projects.length} projects</span>
                </div>

                {projects.map((project, i) => (
                    <div class="project-row">
                        <button
                            class="project-row-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls={`project-detail-${i}`}
                        >
                            <span class="project-row-num">{pad(i + 2)}</span>
                            <span class="project-row-text">
                                <span class="project-row-title">{project.name}</span>
                                <span class="project-row-summary">{project.summary}</span>
                            </span>
                            <span class="project-row-tags" aria-hidden="true">
                                {project.tech.slice(0, 2).map((t) => <span>{t}</span>)}
                            </span>
                            <span class="project-row-arrow" aria-hidden="true">→</span>
                        </button>
                        <div class="project-row-detail" id={`project-detail-${i}`} role="region" aria-label={project.name}>
                            <div class="project-row-inner">
                                <div class="project-row-body">
                                    {project.overview.map((para) => <p>{para}</p>)}
                                    <ul class="project-tags">
                                        {project.tech.map((t) => <li>{t}</li>)}
                                    </ul>
                                    <a class="project-cta" href={project.link.href} target="_blank" rel="noopener">
                                        {project.link.label} <span aria-hidden="true">↗</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
</Layouts>
