---
import Layouts from "../layouts/layouts.astro";
import tiger_img from "../assets/Tiger/tiger_bgr1.png";
import { Image } from "astro:assets";
---

<Layouts
  title="Skills | Mubashir Dawood"
  description="A breakdown of Mubashir Dawood's technical toolkit — frontend, backend, and frameworks spanning JavaScript, Go, Python, and more."
>
  <section id="skills">
    <h1 class="section-title">Toolkit</h1>
    <div class="skills-content">
      <div class="skills-image">
        <Image src={tiger_img} alt="Tiger Kick" loading="eager" />
      </div>
      <div class="skills-list">
        <div class="card">
          <h2>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="feather feather-layout"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="3" y1="9" x2="21" y2="9"></line><line
                x1="9"
                y1="21"
                x2="9"
                y2="9"></line></svg
            >
            Frontend
          </h2>
          <div class="skill-container">
            <span class="skill-tag">HTML</span>
            <span class="skill-tag">CSS</span>
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">TypeScript</span>
            <span class="skill-tag">React</span>
            <span class="skill-tag">Astro</span>
            <span class="skill-tag">SvelteKit</span>
          </div>
        </div>
        <div class="card">
          <h2>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="feather feather-database"
              ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
                d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path
                d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg
            >
            Backend
          </h2>
          <div class="skill-container">
            <span class="skill-tag">Node.js</span>
            <span class="skill-tag">Python</span>
            <span class="skill-tag">Java</span>
            <span class="skill-tag">Go</span>
            <span class="skill-tag">Rust</span>
            <span class="skill-tag">Sqlite</span>
            <span class="skill-tag">Redis</span>
            <span class="skill-tag">Convex</span>
            <span class="skill-tag">MySQL</span>
            <span class="skill-tag">PostgreSQL</span>
          </div>
        </div>
        <div class="card">
          <h2>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="feather feather-box"
              ><path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
              ></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg
            >
            Frameworks
          </h2>
          <div class="skill-container">
            <span class="skill-tag">Express</span>
            <span class="skill-tag">Django</span>
            <span class="skill-tag">Flask</span>
            <span class="skill-tag">Spring Boot</span>
            <span class="skill-tag">Gin</span>
            <span class="skill-tag">FastAPI</span>
          </div>
        </div>
      </div>
    </div>

    <div class="claude-skills">
      <h2 class="claude-skills-title">Claude Skills I've Built</h2>
      <p class="claude-skills-subtitle">
        Custom skills I've directed Claude to build for my own workflow
      </p>
      <div class="claude-skills-grid">
        <div class="claude-skills-row">
          <div class="card claude-skill-card claude-skill-wide">
            <span class="claude-skill-eyebrow">Browser Tooling</span>
            <h3>Tab Bridge</h3>
            <p class="claude-skill-body">
              Lets Claude read a Firefox tab's HTML, console logs, network
              requests, and screenshots — for any tab I explicitly allow. Built
              because I was constantly pasting console errors and HTML snippets
              in by hand while debugging.
            </p>
            <a
              href="https://github.com/MubashirD04/Tab-bridge"
              class="claude-skill-link"
              target="_blank"
              >Try Skill <span aria-hidden="true">&gt;</span></a
            >
          </div>
          <div class="card claude-skill-card claude-skill-narrow">
            <span class="claude-skill-eyebrow">Planning</span>
            <h3>Master Builder</h3>
            <p class="claude-skill-body">
              Turns a rough app idea into a full technical blueprint —
              architecture, data model, API design, security, cost, deployment —
              before any code is written. Built to stop me skipping the
              decisions that bite later.
            </p>
            <a
              href="/downloads/skills/master-builder.skill"
              class="claude-skill-link"
              download
              >Try Skill <span aria-hidden="true">&gt;</span></a
            >
          </div>
        </div>
        <div class="claude-skills-row">
          <div class="card claude-skill-card claude-skill-narrow">
            <span class="claude-skill-eyebrow">SEO</span>
            <h3>SEO Best Practices</h3>
            <p class="claude-skill-body">
              A checklist-driven skill covering on-page, technical, content, and
              off-page SEO. Built so Claude diagnoses issues by actually
              inspecting the page, not guessing from memory.
            </p>
            <a
              href="/downloads/skills/seo-best-practices.skill"
              class="claude-skill-link"
              download
              >Try Skill <span aria-hidden="true">&gt;</span></a
            >
          </div>
          <div class="card claude-skill-card claude-skill-wide">
            <span class="claude-skill-eyebrow">Git Workflow</span>
            <h3>Git Hygiene</h3>
            <p class="claude-skill-body">
              A checklist Claude applies automatically when committing,
              branching, or opening a PR — atomic commits, clear messages,
              short-lived branches, no leaked secrets. Built for consistent
              history without repeating myself every session.
            </p>
            <a
              href="/downloads/skills/git-hygiene.skill"
              class="claude-skill-link"
              download
              >Try Skill <span aria-hidden="true">&gt;</span></a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts>
